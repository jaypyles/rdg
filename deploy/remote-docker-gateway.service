[Unit]
Description=Remote Docker Gateway
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=simple
User=rdg
Group=rdg
SupplementaryGroups=docker
WorkingDirectory=/opt/remote-docker-gateway
EnvironmentFile=-/etc/remote-docker-gateway.env
ExecStart=/usr/local/bin/bun src/index.ts serve
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
KillMode=mixed
SyslogIdentifier=remote-docker-gateway
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/remote-docker-gateway

[Install]
WantedBy=multi-user.target
