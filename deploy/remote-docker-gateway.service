[Unit]
Description=Remote Docker Gateway
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=simple
User=rdg
Group=rdg
SupplementaryGroups=docker
WorkingDirectory=/opt/remote-docker-gateway
EnvironmentFile=-/etc/remote-docker-gateway.env
ExecStart=/usr/local/bin/bun src/index.ts serve
Restart=on-failure
RestartSec=5
# Maintenance (rclone) can run for a long time; don't kill mid-backup on stop.
TimeoutStopSec=120
KillMode=mixed
SyslogIdentifier=remote-docker-gateway
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
# false: rclone needs to read/write ~/.config/rclone and ~/.cache under the service user home.
ProtectHome=false
ReadWritePaths=/opt/remote-docker-gateway

[Install]
WantedBy=multi-user.target
